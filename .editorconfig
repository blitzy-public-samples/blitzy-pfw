# covers the identifier spelling only and changes nothing about that annotation duty.
[services/security-service/PowerFramework.Security/Crypto/LegacyDefaults.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none


# ==============================================================================================
# BAND 4 - THE READ-ONLY BEHAVIOURAL ORACLE. THIS BAND MUST REMAIN LAST.
# ==============================================================================================
# These paths are the read-only legacy tree. They are the behavioural oracle this migration is
# verified against, and they are never edited, deleted, moved or reformatted - not the deferred
# majority of the estate, and not even the files that contain hardcoded secrets, whose remediation
# posture is never-replicate-document-and-rotate rather than edit-the-legacy-file.
#
# EVERYTHING BELOW EXISTS TO PREVENT ACCIDENTAL REFORMATTING. NONE OF IT EXPRESSES A PREFERENCE.
# Nobody wants `insert_final_newline = false`; it is here because ten DataWindow definitions end
# with a trailing space instead of a newline and one of them is the golden-master fixture. Nobody
# wants `trim_trailing_whitespace = false`; it is here because PowerScript exports carry
# meaningful trailing tabs. Read every value below as "leave this file exactly as it is", because
# that is the only thing any of them means.
#
# The mechanism is section order. BAND 1 and BAND 2 above set `charset`, `end_of_line`,
# `indent_style`, `indent_size`, `insert_final_newline` and `trim_trailing_whitespace` for broad
# glob patterns, several of which reach legacy files by extension - `.js` and `.css` under BAND 2
# match 83 vendored scripts and 12 vendored stylesheets, and `.md` matches the five pre-existing
# Chinese documents. Because a later section wins, this band takes those settings back off. Append
# a new general section AFTER this band and the protection is gone; put new sections in BAND 2 or
# BAND 3 instead.
#
# `unset` is used wherever the correct answer is "have no opinion". It is the EditorConfig-standard
# way to make a property behave as though it had never been set, which is stronger than guessing a
# replacement value.

# ----------------------------------------------------------------------------------------------
# PowerBuilder object exports - all 544 objects under ws_objects/
# ----------------------------------------------------------------------------------------------
# Extension census, which reconciles exactly to the 544-object estate: sru 283 non-visual classes,
# srf 151 global functions, srw 71 windows, srs 18 structures, srd 12 DataWindows, srm 4 menus,
# sra 3 application objects, srj 2 project objects.
#
# `srm` is included deliberately. It is easy to omit because menus are only four objects, and
# omitting it would leave those four exposed to every BAND 1 and BAND 2 rule.
#
# `charset = utf-8-bom` is an assertion of measured fact, not a preference: all 544 of these files
# are UTF-8 WITH a byte-order mark, and the BAND 1 default of `utf-8` means UTF-8 WITHOUT one, so
# without this line an editor honouring BAND 1 would strip the BOM from a PowerBuilder export on
# save. Declaring the true encoding is more protective than merely declining to coerce it.
#
# Indentation is unset because these exports are tab-indented and this repository has no business
# having an opinion about that.
[*.{sru,srf,srw,srs,srd,srm,sra,srj}]
charset = utf-8-bom
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# Path-anchored companion to the extension rule above, so that anything under ws_objects/ is
# protected whatever its extension - including any file a future PowerBuilder export adds.
[ws_objects/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# ----------------------------------------------------------------------------------------------
# PowerBuilder libraries, targets, workspaces, resources and compiled artifacts
# ----------------------------------------------------------------------------------------------
# 40 compiled root libraries, three targets, two workspaces, one resource list, one compiled
# dynamic library. `pbg` is listed for completeness even though the repository contains none, so
# that adding one later is already covered. These are the machine-generated module graph and the
# build inputs of a toolchain this refactor does not use; several are binary.
[*.{pbl,pbt,pbw,pbr,pbd,pbg}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# ----------------------------------------------------------------------------------------------
# Legacy browser harness assets, Sciter samples and framework-authored Sciter widgets
# ----------------------------------------------------------------------------------------------
# tests/blink/, tests/sciter/ and tests/webview/ are PRE-EXISTING legacy directories, and the
# Playwright suite this refactor adds is a purely additive sibling at tests/e2e/. tests/ is not a
# greenfield root and must never be treated as one.
#
# 97 of the vendored assets in these trees end without a final newline, and their BOM usage is
# mixed - 5 with, 119 without - which is why `charset` is unset here rather than asserted the way
# it is for the PowerBuilder exports. These directories also hold the vendored .prettierrc and
# .prettierignore that belong to the widget sources, and one of them is a documented hardcoded-key
# site whose file must not be rewritten by anything, least of all a formatter.
[tests/blink/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[tests/sciter/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[tests/webview/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[samples/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[sciter_control/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# ----------------------------------------------------------------------------------------------
# Frozen PowerBuilder 12.5 target, consolidated redistribution libraries, vendored resources
# ----------------------------------------------------------------------------------------------
# oldversion/125/ is a complete frozen target with 30-plus compiled libraries and no source
# exports at all. pack/ holds the consolidated redistribution libraries. res/ holds the fonts and
# images the resource list references. None is a build input to this refactor.
[oldversion/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[pack/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

[res/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# ----------------------------------------------------------------------------------------------
# Named read-only files at the repository root and under docs/
# ----------------------------------------------------------------------------------------------
# pfw.i18n.xml is the legacy localization resource table, read as a data input by the ported
# localization providers. It ends without a final newline, so a normalising save would change it -
# and because it is the table that carries the two mistranslations this refactor must reproduce
# verbatim, changing it is changing the specification.
[pfw.i18n.xml]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false

# logfile.md is the legacy changelog. It is stale - it stops at the 2022 framework release while
# the commit history runs years later - and it is explicitly NOT a specification, but it is still
# read-only history. It carries 17 lines of meaningful trailing whitespace.
[logfile.md]
insert_final_newline = false
trim_trailing_whitespace = false

# The five pre-existing Chinese documents under docs/ are authoritative legacy specifications and
# are read-only; the new documents this refactor authors alongside them are not affected by this
# section. docs/README.md defines the mandatory initialize/finalize pairing and the capability-flag
# modularity mechanism; docs/n_cst_dwsvc_columnexp.md is the authoritative statement of the static
# versus dynamic expansion semantics; docs/PB多线程绕坑提示.md documents the threading hazards and
# carries 3 lines of meaningful trailing whitespace.
[docs/{README,n_cst_dwsvc_columnexp,Blink交互,Sciter交互,PB多线程绕坑提示}.md]
insert_final_newline = false
trim_trailing_whitespace = false
