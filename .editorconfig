[services/dataservices-service/PowerFramework.DataServices/Expressions/ColumnExpressionEngine.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the two macro variable-type discriminators VAR_LOCAL=0 and VAR_FOREIGN=1,
# declared on the type that ports the global variable table so the constant stays adjacent to the
# array it discriminates, exactly as the oracle declares them beside GLOBALVARDATA GlobalVars[].
# VAR_FOREIGN is the value the legacy compares before dereferencing another DataWindow's expression
# service, and a foreign variable cannot be expanded statically.
# Source: ws_objects/pfw.datawindow.services.pbl.src/n_cst_dwsvc_columnexp.sru:L117-L118, declared
# beside the array at :L103, compared at :L1425 and :L2199.
