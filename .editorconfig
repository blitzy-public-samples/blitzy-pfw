[services/dataservices-service/PowerFramework.DataServices/Expressions/ExpressionVariableEnvironment.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the column-sort service's four constants - the public indicator-object suffix
# ARROWSUFFIX="_arw", and the three private sort directions SORT_NONE=0, SORT_ASC=1 and SORT_DESC=2.
# ARROWSUFFIX is the one that needs the suppression: it is PUBLIC in the oracle and stays public here,
# while the three SORT_* values are private in both and CA1707 reports externally-visible declarations
# only. THE ACCESSIBILITY SPLIT IS THE ORACLE'S AND IS NOT LEVELLED - this suppression must not be read
# as licence to promote the three private constants to match the public one, nor to demote ARROWSUFFIX
# to avoid needing this section. The dormant code at :L96-L97 shows external callers were meant to
# recognise an indicator object by the suffix, which is why it is published.
# Source: ws_objects/pfw.datawindow.services.pbl.src/n_cst_dwsvc_columnsort.sru:L26 (public, under the
# `public:` block opened at :L24) and :L37-L39 (private, under the `private:` block opened at :L28).
# A search of enums.sru for ARROWSUFFIX or for any SORT_* name returns nothing, so all four are
# declared on this file rather than arriving with Shared.Kernel's constant catalogue - the same finding
# the RS_* section below records for the row-select service.
# These spellings travel in serialized payloads, log records and characterization recordings, so a
# rename would silently invalidate every stored comparison - here the recordings include the composed
# indicator object names, which embed ARROWSUFFIX verbatim as `colName + ARROWSUFFIX` and
# `colName + "_idx_" + ARROWSUFFIX`. The remaining literals in the same file (the two glyphs, the three
# colour values, the six-space badge padding and the two direction suffixes) are named in PascalCase
# because the oracle spells them as ordinary locals or inline literals rather than as screaming-snake
# constants, so none of them needs anything here.
[services/dataservices-service/PowerFramework.DataServices/Services/ColumnSortModel.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the row-selection styles RS_SINGLE=1 (单选, "single select") and
