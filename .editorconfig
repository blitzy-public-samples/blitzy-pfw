[services/dataservices-service/PowerFramework.DataServices/Domain/EventGate.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the item-change return alphabet {0,1,2,3} and its named members. The
# alphabet is its own enumeration on the wire and is never mapped onto the return-code algebra.
# Four arms, all distinct. PowerScript `choose case` does NOT fall through the way a C switch
# does, which is why an empty arm runs nothing at all rather than continuing into the next one:
#   case 1     an EMPTY arm at :L212 - nothing runs, 1 is returned unchanged so the DataWindow
#              raises ItemValidationError, as the source's own comment at :L210 says
#   case 2     restores value AND status, but only when the pre-check found the value unchanged
#   case 3     keeps the value, does not move focus, and rewrites the result to 1
#   case else  coerces by the first five characters of the column type, fires the changed event,
#              and then forcibly returns 2
# Source: ws_objects/pfw.datawindow.services.pbl.src/se_cst_dw.sru:L182-L253, the dispatch at
# :L211-L252. Case 1 must NOT restore anything: the legacy leaves value and status untouched
# there, and the restore belongs to the validation-error handler that 1 goes on to trigger.
# These spellings travel in serialized payloads, log records and characterization recordings, so a
# rename would silently invalidate every stored comparison.
[services/dataservices-service/PowerFramework.DataServices/Domain/ItemChangeProtocol.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the column-expression engine's tri-state calculation cache CLC_UNKNOWN=0,
# CLC_YES=1, CLC_NO=2 and the two grammar sentinels FUNC_VAR="" and FUNC_INVOKE="Invoke", where
# the empty function name models a bare variable and the reserved name models dynamic dispatch.
# This section also covers the item-calculation entry point, which is declared PUBLIC while
# keeping the legacy private-convention underscore prefix - an anomaly carried across rather than
# tidied, and the one preserved member that raises IDE1006 as well as CA1707.
# Source: ws_objects/pfw.datawindow.services.pbl.src/n_cst_dwsvc_columnexp.sru:L113-L115, L120-L121
