[services/dataservices-service/PowerFramework.DataServices/Domain/DataWindowEventChain.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the seven DataWindow presentation styles STYLE_DEFAULT=0 .. STYLE_RICHTEXT=7 and
