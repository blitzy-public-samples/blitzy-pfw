# These spellings travel in serialized payloads, log records and characterization recordings, so a
# rename would silently invalidate every stored comparison.
[shared/PowerFramework.Shared.Localization/Categories.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the twelve broker topic constants of the DataWindow event chain -
# EVT_ROWFOCUSCHANGING, EVT_ROWFOCUSCHANGED, EVT_ITEMFOCUSCHANGED, EVT_ITEMCHANGED,
# EVT_EDITCHANGED, EVT_CLICKED, EVT_DOUBLECLICKED, EVT_LBUTTONUP, EVT_RBUTTONDOWN, EVT_RBUTTONUP,
# EVT_GETFOCUS and EVT_LOSEFOCUS.
# Source: ws_objects/pfw.datawindow.services.pbl.src/se_cst_dw.sru:L47-L76.
# Both the identifiers AND the values are load-bearing here, which is stronger than for the other
# sections in this band. Two of the twelve carry an ORDERING PREFIX INSIDE THE VALUE -
# EVT_ITEMCHANGED is "0-itemchanged" [:L54] and EVT_EDITCHANGED is "1-editchanged" [:L57] - and the
# broker's dispatch order derives from the ascending ordinal sort of the subscription name, so the
# digits are functional rather than decorative. The identifiers additionally appear as the
# BrokerTopic.WellKnownName enumerators on contract C-03
# [shared/PowerFramework.Contracts/Proto/dataservices.v1.proto].
# These spellings travel in serialized payloads, log records and characterization recordings, so a
