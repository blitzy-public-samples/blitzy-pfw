# ==============================================================================================
# .editorconfig
# Repository-root EditorConfig for the PowerFramework .NET 10 decomposition.
# ==============================================================================================
#
# WHAT THIS FILE IS, AND WHY IT IS NOT AN ORDINARY .editorconfig
# Most of this file is ordinary formatting convention. BAND 3 is not: it carries the analyzer
# severity overrides that let this repository keep the legacy constant identifier spellings under
# a warnings-as-errors build. The mechanism, in order:
#
#     Directory.Build.props    sets TreatWarningsAsErrors=true, EnableNETAnalyzers=true and
#                              AnalysisLevel=latest for every project in the solution, and deliberately
#                              declares NO suppression of its own
#     this file                scopes the naming suppressions to the individual files that
#                              genuinely declare the preserved identifiers
#
# Directory.Build.props states that delegation explicitly in its warning-policy section, and it
# also forbids NoWarn, WarningsNotAsErrors and any project-wide or repository-wide analyzer
# suppression, precisely because such a suppression would silently widen the exception from a
# handful of constant catalogues to every project in the solution. Do not move any suppression from BAND 3
# into that file, and do not widen a BAND 3 glob. The narrowness IS the design.
#
# THERE IS NO LEGACY SOURCE EQUIVALENT TO TRANSLATE
# The Appeon PowerBuilder 2021 framework this .NET tree is added to has no build system, no
# formatting configuration and no linter configuration in any form. This file is authored from
# scratch. Its SUBJECT MATTER, however, is entirely legacy-derived: every identifier family
# protected in BAND 3 is cited back to the exact PowerScript declaration site that produces it.
#
# THE LEGACY TREE IS READ-ONLY AND SHARES THIS WORKING DIRECTORY
# This is the single most important thing to understand before editing this file. A root
# .editorconfig is consulted by editors for EVERY file beneath it, and beneath this one sit 544
# read-only PowerBuilder objects totalling roughly 160,445 lines of PowerScript, a frozen
# PowerBuilder 12.5 target, consolidated redistribution libraries, closed-source native binaries,
# vendored fonts and images, six Sciter sample applications, framework-authored Sciter widgets and
# three directories of vendored browser harness assets. They are the behavioural oracle for parity
# testing. An over-broad whitespace or charset rule here does not merely annoy: it silently
# rewrites the oracle on the next save and invalidates every stored characterization comparison.
# BAND 4 exists to stop that, and the hazards it neutralises were measured, not imagined:
#
#     544 of 544  objects under ws_objects/ are UTF-8 WITH a byte-order mark, so a bare
#                 `charset = utf-8`, which means UTF-8 without a BOM, is a BOM-stripping rule
#      10 of 544  objects end with a trailing SPACE and no final newline - all ten are DataWindow
#                 definitions, and one of them is ws_objects/pfw.tests.pbl.src/dw_sqlite.srd, the
#                 only updatable DataWindow in the repository and therefore the golden-master
#                 fixture for the whole retrieve/validate/update triple
#          97     vendored browser assets under samples/, sciter_control/ and tests/ end without a
#                 final newline
#           1     read-only data input, pfw.i18n.xml, ends without a final newline
#      17 / 3 / 1 lines carrying meaningful trailing whitespace in logfile.md,
#                 docs/PB多线程绕坑提示.md and README.md respectively
#
# SECTION ORDER IS LOAD-BEARING
# EditorConfig applies every matching section in file order, and for any single property the LAST
# matching section wins. The four bands below therefore run from most general to most protective:
#
#     BAND 1   universal baseline, deliberately WITHOUT any whitespace-mutating property
#     BAND 2   the file types this refactor authors, which opt IN to whitespace normalisation
#     BAND 3   scoped naming-analyzer suppressions for the preserved constant identifiers
#     BAND 4   the read-only legacy oracle, which opts every mutation back OUT
#
# BAND 4 MUST REMAIN LAST. Appending a new general section after it would re-expose the legacy
# tree to the mutations BAND 4 turns off. Add new sections inside BAND 2 or BAND 3, never after
# BAND 4.
#
# SEVERITY POLICY
# No stylistic preference in this file is expressed at `warning` or `error`. Every one is `silent`
# or `suggestion`. That is a deliberate constraint, not an oversight: this refactor preserves
# legacy behaviour exactly, reviewers compare the ported C# against the PowerScript side by side,
# and a rule that mandated expression-bodied members, switch expressions, pattern matching or a
# particular namespace form would force the ported control flow to diverge from the source it is
# supposed to mirror. Guidance is welcome here; gates are not. The only hard gate in the build is
# the one Directory.Build.props owns, and no analyzer package is referenced by this refactor.
# ==============================================================================================

root = true


# ==============================================================================================
# BAND 1 - UNIVERSAL BASELINE
# ==============================================================================================
# Intentionally minimal, and intentionally free of `insert_final_newline` and
# `trim_trailing_whitespace`. Those two are the properties that rewrite a file on save, so they
# are granted per file type in BAND 2 rather than assumed globally. Setting them here would have
# put the 10 DataWindow definitions and 97 vendored assets measured above one keystroke away from
# corruption, and BAND 4 would have been the only thing standing between the oracle and a
# reformat. Defence in depth is cheaper than that.
#
# `charset` and `end_of_line` are safe to state globally because BAND 4 overrides both for every
# read-only region, and because the read-only text regions were verified to contain no CRLF, so
# `lf` describes what is already on disk rather than proposing a change to it.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4


# ==============================================================================================
# BAND 2 - FILE TYPES THIS REFACTOR AUTHORS
# ==============================================================================================
# Only the types created by this refactor opt in to whitespace normalisation. Nothing here
# matches a legacy extension, and BAND 4 re-asserts protection for the two types that overlap by
# necessity, Markdown and vendored web assets.

# ----------------------------------------------------------------------------------------------
# C#
# ----------------------------------------------------------------------------------------------
# Conventional .NET layout: four-space indent, Allman braces, System directives first, one using
# group. Every `csharp_style_*` and `dotnet_style_*` preference below carries an explicit
# severity, and every one of those severities is `silent` or `suggestion`, so none can become a
# build error under TreatWarningsAsErrors. See the SEVERITY POLICY note in the header.
[*.cs]
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:silent

# Braces and new lines - Allman, which is the .NET default and what the SDK templates emit
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

# Spacing
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# Wrapping - single-line blocks are preserved so a ported guard clause may stay on one line the
# way its PowerScript original does; single-line statements are not, so genuinely dense lines get
# split.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# ----------------------------------------------------------------------------------------------
# C# style preferences that must never become gates
# ----------------------------------------------------------------------------------------------
# These are stated explicitly rather than left to SDK defaults for one reason: each of them, if
# it ever reached `warning`, would demand that ported code be rewritten into a shape its
# PowerScript original does not have. Pinning them to `silent` makes that impossible whether or
# not a future build turns on code-style enforcement. This is the direct expression of the
# no-behaviour-improvement constraint in a settings file.
csharp_style_namespace_declarations = block_scoped:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_expression_bodied_indexers = when_on_single_line:silent
csharp_style_expression_bodied_accessors = when_on_single_line:silent
csharp_style_expression_bodied_lambdas = when_on_single_line:silent
csharp_style_expression_bodied_local_functions = when_on_single_line:silent
csharp_style_prefer_switch_expression = true:silent
csharp_style_prefer_pattern_matching = true:silent
csharp_style_pattern_matching_over_is_with_cast_check = true:silent
csharp_style_pattern_matching_over_as_with_null_check = true:silent
csharp_style_prefer_primary_constructors = false:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# Formatting enforcement is guidance only, for the same reason. IDE0055 reports any deviation
# from every `csharp_space_*`, `csharp_new_line_*` and `csharp_indent_*` value above as a single
# diagnostic; at `warning` under TreatWarningsAsErrors that would make the layout of ported code
# a build gate. `suggestion` keeps the guidance visible in an editor and out of the build.
dotnet_diagnostic.IDE0055.severity = suggestion

# ----------------------------------------------------------------------------------------------
# Naming conventions - guidance for NEW code, at suggestion severity only
# ----------------------------------------------------------------------------------------------
# Three rules, chosen because they are universally agreed and cannot collide with a ported name.
# Private and protected fields are deliberately NOT constrained, so that neither the underscore
# prefix convention nor a ported field name spelled the way its PowerScript original was becomes
# a talking point. Types, interfaces and externally visible members are covered.
#
# Worth knowing before assuming these rules do the work of BAND 3: they do not. A naming style
# with no configured word separator treats an identifier as a single word and checks only the
# first character's case, so E_INVALID_ARGUMENT satisfies a pascal_case rule and produces no
# IDE1006 at all. The diagnostic that actually reports an underscore is CA1707, which is why
# CA1707 leads every BAND 3 section.
dotnet_naming_rule.types_should_be_pascal_case.symbols = pfw_types
dotnet_naming_rule.types_should_be_pascal_case.style = pfw_pascal_case
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_symbols.pfw_types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_symbols.pfw_types.applicable_accessibilities = *

dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = pfw_interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = pfw_pascal_case_prefixed_with_i
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = suggestion
dotnet_naming_symbols.pfw_interfaces.applicable_kinds = interface
dotnet_naming_symbols.pfw_interfaces.applicable_accessibilities = *

dotnet_naming_rule.visible_members_should_be_pascal_case.symbols = pfw_visible_members
dotnet_naming_rule.visible_members_should_be_pascal_case.style = pfw_pascal_case
dotnet_naming_rule.visible_members_should_be_pascal_case.severity = suggestion
dotnet_naming_symbols.pfw_visible_members.applicable_kinds = method,property,event
dotnet_naming_symbols.pfw_visible_members.applicable_accessibilities = public,internal,protected,protected_internal

dotnet_naming_style.pfw_pascal_case.capitalization = pascal_case
dotnet_naming_style.pfw_pascal_case_prefixed_with_i.capitalization = pascal_case
dotnet_naming_style.pfw_pascal_case_prefixed_with_i.required_prefix = I

# ----------------------------------------------------------------------------------------------
# MSBuild, solution and other XML-shaped build files
# ----------------------------------------------------------------------------------------------
# `slnx` is the .NET 10 XML solution format, which is what `dotnet new sln` emits on this SDK.
# `slnf` is deliberately absent: legacy solution filters are incompatible with .slnx and fail
# with MSB4014 during restore, build and test, so this refactor uses per-service .slnx files and
# authors no filter for one to match.
[*.{csproj,props,targets,slnx}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ----------------------------------------------------------------------------------------------
# Configuration and orchestration
# ----------------------------------------------------------------------------------------------
# Covers appsettings.json per service, the compose manifest, the CI workflow and the OpenAPI
# contract documents under shared/PowerFramework.Contracts/OpenApi/. No `[*.xml]` section exists
# anywhere in this file, deliberately: the only XML at the repository root that is not an MSBuild
# file is pfw.i18n.xml, a read-only legacy data input, and the cleanest way to keep it untouched
# is to never write a rule that reaches it. BAND 4 protects it belt-and-braces regardless.
[*.{json,jsonc}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ----------------------------------------------------------------------------------------------
# Protocol definitions - shared/PowerFramework.Contracts/Proto/
# ----------------------------------------------------------------------------------------------
[*.proto]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ----------------------------------------------------------------------------------------------
# TypeScript and JavaScript - the Playwright suite under tests/e2e/ only
# ----------------------------------------------------------------------------------------------
# Indentation and whitespace only. No linter, formatter or style tooling is configured here or
# anywhere else in this refactor. BAND 4 re-protects the vendored .js assets that share these
# extensions but are read-only legacy, and it does so by path so that this extension-based
# section cannot reach them.
[*.{ts,tsx,js,mjs,cjs}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ----------------------------------------------------------------------------------------------
# Markdown
# ----------------------------------------------------------------------------------------------
# `trim_trailing_whitespace` is off for Markdown as a whole, and that single setting is doing two
# jobs at once. It is the correct Markdown convention, because two trailing spaces are a
# significant hard line break rather than stray whitespace. It is also load-bearing protection:
# logfile.md carries 17 such lines, docs/PB多线程绕坑提示.md carries 3, and README.md carries 1.
# All three are read-only or verbatim-preserving - README.md is the only pre-existing file this
# refactor updates at all, and its BSD 2-Clause notice and the four-condition Chinese restatement
# beneath it must survive byte for byte.
#
# `insert_final_newline` is safe to leave on: every pre-existing Markdown file in the repository
# was verified to end with a newline already, so the rule describes them rather than changing
# them, and the new documents this refactor authors get the normalisation.
[*.md]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = false

# ----------------------------------------------------------------------------------------------
# Container definitions and shell
# ----------------------------------------------------------------------------------------------
# One Dockerfile per in-scope service, multi-stage sdk to aspnet, non-root. Shell indentation is
# two spaces to match the orchestration files these scripts sit beside.
[Dockerfile]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[.dockerignore]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true


# ==============================================================================================
# BAND 3 - SCOPED NAMING SUPPRESSIONS FOR THE PRESERVED CONSTANT IDENTIFIERS
# ==============================================================================================
# THE DECISION THESE SECTIONS RECORD
# This refactor keeps the legacy constant identifiers spelled exactly as PowerScript declares
# them - RetCode.OK, RetCode.E_INVALID_ARGUMENT, RetCode.CANCELLED, Enums.SQL_MS_REPLACE,
# Enums.INIT_FLAG_ENABLE_SQLITE, Categories.CAT_DWSVC and the rest - in deliberate defiance of
# .NET naming convention. The reason is data integrity, not taste. Those exact identifier strings
# appear in serialized payloads on the new service contracts, in log records, and in the
# characterization recordings that are the parity evidence for the whole migration. Renaming one
# does not merely restyle a symbol; it silently invalidates every stored comparison that mentions
# it, and a golden-master suite cannot report a comparison it can no longer make.
#
# Two spellings make the point concretely. CANCELED and CANCELLED both exist, both equal -2, and
# both are real: they are two names for one constant, not a typo to deduplicate. OK, SUCCESS and
# ALLOW are three names for 0. Any tidying of that redundancy changes what appears in a recording.
#
# WHY A SUPPRESSION IS NEEDED AT ALL
# Directory.Build.props sets TreatWarningsAsErrors=true, so any naming diagnostic raised against
# these identifiers is a build failure rather than advice. Measured on this toolchain, SDK 10.0.302
# at AnalysisLevel=latest:
#
#     default AnalysisMode        CA1707 is off; the preserved identifiers build clean today
#     AnalysisMode=Recommended    CA1707 is ON
#     AnalysisMode=All            CA1707 is ON
#
# So these sections are the guard that keeps a routine hardening of the analysis mode from
# breaking the port, which is exactly the role Directory.Build.props assigns them. They are not
# dead weight waiting for a hypothetical: raising AnalysisMode is a one-property change, and the
# identifiers it would reject are non-negotiable.
#
# WHICH DIAGNOSTICS, AND WHY THESE TWO
#     CA1707   "Identifiers should not contain underscores". The load-bearing one. It is the only
#              diagnostic in the SDK's analyzer set that actually reports these spellings, and it
#              reports DECLARATIONS only, never uses - which is why a file that merely consumes a
#              preserved constant needs no entry here.
#     IDE1006  "Naming rule violation", the diagnostic behind the dotnet_naming_* rules in BAND 2.
#              Editors surface it live regardless of whether the build enforces code style, and it
#              genuinely fires on at least one preserved member: the column-expression engine's
#              item-calculation entry point keeps its legacy underscore prefix even though it is
#              public, and a leading underscore fails a pascal_case rule.
#
# WHAT IS DELIBERATELY NOT SUPPRESSED
# CA1027 "Mark enums with FlagsAttribute", CA1008 "Enums should have zero value" and CA1802 "Use
# literals where appropriate" also fire on this kind of content once the analysis mode is raised.
# They are enum-shape and field-storage DESIGN findings, not identifier-spelling findings, so the
# preservation rationale above does not cover them and silencing them here would hide real
# feedback from the authors of these files. Scope discipline cuts both ways.
#
# HOW TO MAINTAIN THIS BAND
# One section per DECLARING file, each named in full - no wildcard broader than a single file, and
# never `[*.cs]`. A blanket suppression would let genuinely badly named new code through, which is
# the precise opposite of the intent. Every path below is enumerated verbatim in the refactor's
# target-structure specification; a section whose file has not been authored yet is inert and
# becomes effective the moment the file lands, so leaving it in place is correct rather than
# speculative. When adding a section, cite the PowerScript declaration site the way the existing
# ones do, so the exception can be audited instead of guessed at.
#
# ==============================================================================================
# THE ROSTER - THIS LIST IS THE SINGLE SOURCE OF TRUTH FOR "WHICH FILES ARE IN BAND 3"
# ==============================================================================================
# 16 SECTIONS, ALL 16 EFFECTIVE - every file named below exists in the tree.
#
#      1  shared/PowerFramework.Shared.Kernel/RetCode.cs                                  effective
#      2  shared/PowerFramework.Shared.Kernel/Enums.cs                                    effective
#      3  shared/PowerFramework.Shared.Localization/Categories.cs                         effective
#      4  .../PowerFramework.DataServices/Domain/DataWindowEventChain.cs                  effective
#      5  .../PowerFramework.DataServices/Domain/DataWindowServiceHost.cs                 effective
#      6  .../PowerFramework.DataServices/Domain/EventGate.cs                             effective
#      7  .../PowerFramework.DataServices/Domain/ItemChangeProtocol.cs                    effective
#      8  .../PowerFramework.DataServices/Expressions/ColumnExpressionEngine.cs           effective
#      9  .../PowerFramework.DataServices/Expressions/ExpressionVariableEnvironment.cs    effective
#     10  .../PowerFramework.DataServices/Services/ColumnSortModel.cs                     effective
#     11  .../PowerFramework.DataServices/Services/RowSelectService.cs                    effective
#     12  .../PowerFramework.DataServices/Services/ContextMenuModel.cs                    effective
#     13  .../PowerFramework.DataServices/Services/DropDownSearchModel.cs                 effective
#     14  .../PowerFramework.Persistence/Sql/ClauseModifier.cs                            effective
#     15  .../PowerFramework.Persistence/Sql/Paging/IPagingRewriter.cs                    effective
#     16  .../PowerFramework.Security/Crypto/LegacyDefaults.cs                            effective
#
# ENTRY 5 WAS MISSING AND IS THE REASON THIS ROSTER IS AUDITED RATHER THAN TRUSTED. The roster claims
# to be the single source of truth for band membership, and DataWindowServiceHost.cs - which declares
# fourteen public SCREAMING_SNAKE constants - was absent from it while the twelve files around it were
# present. A roster that is authoritative and incomplete is worse than one that is neither, because
# nothing downstream re-derives it: the file's constants would have been reported by the naming
# diagnostics the moment the analysis mode is raised, and the obvious repair under time pressure is a
# broadened glob, which would suppress the diagnostic for files that have no exception to claim.
#
# ENTRY 7 WAS THE PENDING ONE AND IS NOW EFFECTIVE. ColumnExpressionEngine.cs was enumerated in the
# target-structure specification before it was authored, and its section was carried inert on the
# strength of the maintenance rule above; the file has since landed, so the section now suppresses
# what it was written for. The `_of_calcitem` entry point it exists for - public despite its legacy
# underscore prefix - is the one member in the whole port that trips IDE1006 rather than CA1707, so
# it remains the least reconstructible entry in the band.
#
# THE THREE HEADLESS DATAWINDOW SERVICE MODELS EACH EARNED THEIR OWN SECTION as they were ported:
# ColumnSortModel.cs for SORT_*/ARROWSUFFIX, ContextMenuModel.cs for the nine reserved MID_* command
# identifiers, and DropDownSearchModel.cs for the FILTER_* bitmask. None of the three alphabets is
# declared in the shared kernel's catalogue - a search of enums.sru returns nothing for any of them -
# so in the .NET tree each belongs to the file that declares it, which is why the band grew by three
# sections rather than by three entries on an existing one.
#
# WHY A ROSTER LIVES HERE AND NOWHERE ELSE
# Comment blocks throughout the repository used to restate this list as a COUNT in prose - build
# documentation, the event broker, test doubles, a system-error handler, an options type, several
# validators and providers, the container types, and both paging rewriters. They disagreed with each
# other and with reality, variously claiming seven, nine and ten NAMED files, because each was a
# copy of a number with no mechanism keeping it honest and every copy went stale the moment a
# section was added. They now point HERE instead of restating it, so there is exactly one place to
# update and no second place to fall out of step. If you add or remove a section, update this
# roster; nothing else needs touching, and nothing else should be made to carry the count again.

# Preserved verbatim: the return-code algebra - OK/SUCCESS/ALLOW=0, PREVENT=1, FAILED=-1,
# CANCELED=-2 and CANCELLED=-2, the contiguous E_INVALID_ARGUMENT..E_RETRY block,
# E_NO_SUPPORT=-2000, E_NO_IMPLEMENTATION=-2001, UNKNOWN=-4000, the XML_* set and the full
# SQLITE_* set including the extended codes computed as base plus n x 256.
# Source: ws_objects/pfw.shared.pbl.src/retcode.sru:L39-L221 (221 lines of constants).
# These spellings travel in serialized payloads, log records and characterization recordings, so a
# rename would silently invalidate every stored comparison.
[shared/PowerFramework.Shared.Kernel/RetCode.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Preserved verbatim: the constant catalogue - the eight capability bits INIT_FLAG_ENABLE_UI=1,
# SCITER=2, BLINK=4, BLINKFAST=8, ORCA=256, SQLITE=512, DPIAWARE=1024, WEBVIEW=2048 and the
# composite INIT_FLAG_ENABLE_ALL, which deliberately OMITS BLINKFAST because blink.dll and
# blinkfast.dll are alternative builds of one engine; the clause-modification styles
# SQL_MS_REPLACE=1, SQL_MS_APPEND=2, SQL_MS_PREPEND=3; and the CRYPTO_* algorithm identifier sets
# including CRYPTO_SYMCRYPT_MODE_DEFAULT, which resolves to ECB.
# Source: ws_objects/pfw.shared.pbl.src/enums.sru:L41-L49, L717-L719, L924-L967 (1,162 lines).
# These spellings travel in serialized payloads, log records and characterization recordings, so a
# rename would silently invalidate every stored comparison. The omission of BLINKFAST from
# INIT_FLAG_ENABLE_ALL is legacy behaviour and is not a defect to correct; suppressing the naming
# diagnostic here must not be read as licence to tidy the accompanying explanatory comment away.
[shared/PowerFramework.Shared.Kernel/Enums.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none

# NO ENTRY FOR shared/PowerFramework.Shared.Eventful/VetoResult.cs, AND THAT IS DELIBERATE.
# The tri-valued veto it models is a preserved legacy behaviour - PREVENT_ONCE=1 and PREVENT_DEEP=2
# with continue as the third state [ws_objects/pfw.utility.invoker.pbl.src/n_cst_eventful.sru:
# L111-L112] - but preserving a BEHAVIOUR is not the same as preserving an IDENTIFIER SPELLING, and
# only the latter needs a suppression here. That file declares its members as Continue, PreventOnce
# and PreventDeep: ordinary PascalCase, carrying no underscore, raising neither CA1707 nor IDE1006.
# An entry for it would therefore suppress diagnostics that cannot fire, which is exactly the kind
# of unnecessary exception the narrowness rule above exists to prevent - and a dead suppression is
# worse than none, because it advertises a constraint the file does not actually have and would keep
# covering the file if a genuine violation were introduced later. Do not add one back.

# Preserved verbatim: the localization category offsets - CAT_MSGBOX and CAT_DWSVC, each declared
# as an offset from I18N_CAT_CUSTOM. CAT_DWSVC is reached from inside the DataWindow validation
