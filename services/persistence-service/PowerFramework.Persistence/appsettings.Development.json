{
  "Logging": {
    "LogLevel": {
      "PowerFramework.Persistence": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    // Loopback in place of the orchestration service name, and NOTHING ELSE changes. The scheme
    // stays https and RequireHttpsMetadata stays inherited as true: Security's listener is TLS in
    // development as well as deployed, because `POST /v1/tokens` authenticates its caller with a
    // client certificate, which cannot be presented on a plaintext listener at all. A local
    // instance's self-signed certificate is trusted through the host trust store, never by turning
    // a validation setting off here.
    "Authority": "https://localhost:5104"
  },
  "Sqlite": {
    "DataDirectory": "/tmp/powerframework"
  }
}
