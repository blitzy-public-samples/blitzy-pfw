{
  "Logging": {
    "LogLevel": {
      "PowerFramework.Persistence": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    // Loopback in place of the orchestration service name, and NOTHING ELSE changes. The scheme is
    // the one Security actually binds - https, in every environment including this one - and
    // RequireHttpsMetadata stays inherited as TRUE, which the https authority above satisfies. There is
    // deliberately NO relaxation here: the development concession this system permits is a SELF-SIGNED
    // certificate whose anchor arrives through INTERNAL_TLS_TRUSTED_CA_PATH, never a plaintext
    // authority, because the fetch beneath this address retrieves the verification key set and a
    // rewritable key set makes this service accept tokens an attacker signed (CWE-319). This overlay
    // changes the HOST and nothing about what is validated: the four mandatory verifier checks are not
    // configurable in any environment.
    "Authority": "https://localhost:5104"
  },
  "Sqlite": {
    "DataDirectory": "/tmp/powerframework"
  }
}
