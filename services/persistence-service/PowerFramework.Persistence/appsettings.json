{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ----------------------------------------------------------------------------------------------
  // KESTREL - TWO TLS ENDPOINTS, ONE PER PROTOCOL VERSION. Read this before merging them together:
  // under TLS one port COULD carry both, and they are kept apart deliberately.
  // ----------------------------------------------------------------------------------------------
  //
  // THE CONSTRAINT, MEASURED ON SDK 10.0.302 RATHER THAN ASSUMED. A single CLEARTEXT endpoint with
  // Protocols "Http1AndHttp2" does NOT serve both versions: Kestrel logs, at warning level,
  //
  //     HTTP/2 is not enabled for [::]:PORT. The endpoint is configured to use HTTP/1.1 and HTTP/2,
  //     but TLS is not enabled. HTTP/2 requires TLS application protocol negotiation. Connections to
  //     this endpoint will use HTTP/1.1.
  //
  // and an HTTP/2 prior-knowledge request to that port fails outright ("Remote peer returned
  // unexpected data while we expected SETTINGS frame"). Cleartext HTTP/2 requires an endpoint
  // configured for HTTP/2 ALONE, and such an endpoint answers an HTTP/1.1 request with 400.
  //
  // WHY TLS ON BOTH. Every request across either endpoint carries a bearer token, and this service is
  // the only one with a storage provider - so a readable channel exposes both the credential and the
  // data it authorises (CWE-319). The environment's `curl -sf http://localhost:5101/health` gate is a
  // probe SHAPE and restates as `curl -sf --cacert <anchor> https://localhost:5101/health`, which is
  // what this image's HEALTHCHECK does; the certificate comes from
  // `Kestrel__Certificates__Default__Path` and `__KeyPath` in the deployment's secret layer, and
  // Kestrel REFUSES TO START rather than downgrading if it cannot resolve one.
  //
  // THE TWO KINDS OF TRAFFIC KEEP ONE ENDPOINT EACH, AND THE REASON IS MISADDRESSING RATHER THAN
  // NECESSITY. Each endpoint pins ONE protocol version, so a probe and a gRPC channel each reach a
  // listener that can only answer the thing it is for - a gRPC channel aimed at 5101 fails with
  // HTTP_1_1_REQUIRED before the request arrives, and an HTTP/1.1 probe aimed at 5111 gets a 400.
  // Under `Http1AndHttp2` both mistakes would succeed at the transport layer and fail later, somewhere
  // less obviously attributable.
  //   * `Rest`  https://+:5101, HTTP/1.1 - the anonymous /health readiness probe and the
  //     bearer-authenticated /v1/ping. 5101 is exactly the port the environment documents and AAP
  //     0.3.2.2 assigns, so the documented probe is answered on the documented address, unchanged.
  //   * `Grpc`  https://+:5111, HTTP/2 - contracts C-05 through C-08, whose only
  //     caller is DataServices inside the orchestration network. The environment documents no gRPC
  //     address at all, so nothing it fixes is being moved; 5111 sits OUTSIDE the documented
  //     5101-5105 band precisely so it cannot collide with it and cannot encroach on 5103, which
  //     stays the reserved Phase-2 slot (C-D).
  //
  // Protocols is stated EXPLICITLY on both, and neither says "Http1AndHttp2" - which under TLS would
  // work. Naming it would make each endpoint accept traffic it is not the address for, which is the
  // one thing this split exists to prevent.
  //
  // A TLS-TERMINATING DEPLOYMENT COLLAPSES THIS BACK TO ONE PORT AND NEEDS NO CODE CHANGE: point
  // Kestrel__Endpoints__Rest__Url at https://+:5101 with Protocols Http1AndHttp2, supply
  // Kestrel__Certificates__Default__Path and __KeyPath from its own secret layer, and drop the Grpc
  // endpoint - ALPN then negotiates both versions on the one address. No certificate, key, password
  // or thumbprint appears in this file in either arrangement (C-F).
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "https://+:5101",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "https://+:5111",
        "Protocols": "Http2"
      }
    }
  },

  // ----------------------------------------------------------------------------------------------
  // INBOUND TOKEN VALIDATION (C-G). Every route but /health carries a bearer token verified against
  // Security's published material; this service mints nothing.
  // ----------------------------------------------------------------------------------------------
  //
  // THE FOUR MANDATORY VERIFIER CHECKS ARE NOT LEAVES HERE, AND THAT ABSENCE IS THE CONTROL. Issuer,
  // audience, lifetime and signing-key validation are set UNCONDITIONALLY in Program.cs and are not
  // read from configuration at all, so no environment override can switch one off; the clock-skew
  // tolerance is pinned and bounded there for the same reason. A leaf here would advertise a switch
  // that does not exist.
  //
  // NO JwksPath LEAF, AND ITS REMOVAL IS DELIBERATE. One was declared, validated and never read: the
  // bearer handler resolves its metadata from `Authority` (appending the well-known path itself) or
  // from an explicit `MetadataAddress`, so a third key describing the same thing could disagree with
  // both while changing nothing. `MetadataAddress` remains the supported override and is the one to
  // set when a deployment publishes the key set somewhere other than beneath the authority.
  //
  // RequireHttpsMetadata IS true BECAUSE THE AUTHORITY IS AN https ADDRESS. The setting names a fact
  // about the authority beside it rather than a hardening level: true against an `http` authority does
  // not make the fetch secure, it makes the fetch FAIL. It stays a leaf so that the pair can only ever
  // be changed together, and a coherence test asserts they never disagree inside one file.
  //
  // MetadataAddress IS DECLARED AND EMPTY, WHICH IS NOT THE SAME AS ABSENT. Program.cs reads it and
  // applies it only when non-empty, so a null here means "resolve discovery from the authority" while
  // still making the override visible to anyone auditing this file for the keys the service consumes.
  "Jwt": {
    "Authority": "https://security-service:5104",
    "MetadataAddress": null,
    "Audience": "powerframework-persistence",

    // THERE IS NO JwksPath KEY, AND THERE MUST NOT BE ONE. The key set is found by standard discovery:
    // the stock bearer handler fetches <Authority>/.well-known/openid-configuration and follows the
    // `jwks_uri` it publishes. A JwksPath key here would be bound and validated while governing
    // nothing, so an operator overriding it would change nothing and believe otherwise. The single
    // supported override is Jwt:MetadataAddress, which moves the DISCOVERY document - a different
    // document from the key set - for a deployment that republishes Security on another path.
    "RequireHttpsMetadata": true,

    // WHO MAY CALL THIS SERVICE AT ALL. Audience validation proves a token was minted FOR this service;
    // this proves it was minted for a caller this service serves. The AAP fixes the call graph as layered
    // and acyclic - nothing but DataServices calls Persistence - so the roster is exactly one identity, and
    // it is declared here rather than defaulted in code so a deployment can audit it by reading this file.
    // An empty roster refuses every caller and fails validation, deliberately: reading it as "permit
    // everyone" would be the fail-open default this setting exists to remove.
    "PermittedCallers": [ "powerframework-dataservices" ],

    // The four token-validation checks. Each removes an entire class of forgery, so none is a deployment
    // choice: the bearer handler is configured with all four enabled regardless of these values and the
    // options validator REFUSES a false, because a setting silently ignored is worse than one honoured.
    // They are stated here so a deployment can be audited for them by reading this file.
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "Sqlite": {
    "DataDirectory": "/var/lib/powerframework",
    "DatabaseFileName": "test.db",
    "Mode": "rwc",
    "Check": null,
    "Journal": "DELETE"
  },
  "TransactionPool": {
    "KeepAlive": false,
    "KeepAliveExpireSeconds": 0,
    "TransactionClassName": "",
    "IdleSweepIntervalSeconds": 15
  },
  "Query": {
    "ChunkSize": 10000,
    "MaxRows": 0,
    "PageCounting": true,
    "Cache": false,
    "PageIndex": 0,
    "PageSize": 0,
    "Paged": false
  },
  "InternalTls": {
    "TrustedCaPath": ""
  },

  // THE BOUNDS ON SERVER-HELD WORK HANDLES - the cost of the boundary, not a feature. In process a caller
  // held its task and its transaction by REFERENCE and an abandoned one was collected; across a boundary a
  // caller holds a NAME and the server holds the object, so a caller that crashes or forgets to release
  // leaves a live transaction, an open connection and - for a command or update task - a worker task alive
  // for the life of the PROCESS. Reaching a ceiling refuses the CREATION of a new handle with E_BUSY, which
  // DataServices projects onto HTTP 429; it never evicts a handle a caller already holds. The idle window is
  // swept every interval, so a handle survives its window plus up to one interval, and a streamed retrieval
  // that is provably in flight is never reclaimed at all. See Runtime/HandleLifecycle.cs.
  "Handles": {
    "MaxTotalPerRegistry": 512,
    "MaxPerPrincipal": 128,
    "IdleExpirySeconds": 900,
    "SweepIntervalSeconds": 60
  },

  // THE DATA-OBJECT DEFINITIONS A CALLER MAY NAME. In the legacy, assigning a name loads a compiled
  // DataWindow out of the target's library list; the `.srd` objects live in the read-only legacy tree and no
  // managed runtime can load one, so the material a name resolves TO is a deployment fact and belongs here.
  //
  // The single entry below is `dw_sqlite`, transcribed field for field from the ONLY updatable DataWindow in
  // the repository [ws_objects/pfw.tests.pbl.src/dw_sqlite.srd] - which is also the golden-master fixture for
  // the whole retrieve/validate/update triple. Its three preserved type divergences from the DDL are NOT
  // corrected here: the address column is declared 200 wide against a CHAR(50), the salary is a two-place
  // decimal against a REAL, and the birth column is a date against a TEXT. Those are legacy defects and the
  // refactor replicates them rather than fixing them.
  //
  // A caller that supplies its own statement or result syntax needs no entry here, and an empty section is
  // legal - it simply means no name resolves.
  "DataObjects": [
    {
      "Name": "dw_sqlite",
      "SqlSelect": "SELECT * FROM COMPANY",

      // THE TRAILING SPACE IS PART OF THE VALUE [dw_sqlite.srd:L14]. It is preserved verbatim because the
      // sort expression is compared against a snapshot on the datastore cache path, and normalising it would
      // make a cached carrier and a fresh one disagree.
      "Sort": "age A salary A ",
      "Filter": "",
      "Processing": "1",
      "Arguments": "",
      "Units": "1",

      "UpdateTable": "COMPANY",
      "UpdateWhere": 1,
      "UpdateKeyInPlace": false,

      // Column order IS column number: the first entry is column 1. All six carry
      // `update=yes updatewhereclause=yes` [dw_sqlite.srd:L8-L14], so the concurrency predicate spans all
      // six original values - which is what `UpdateWhere: 1` means and why the payload has to carry both the
      // current and the original value of every one of them.
      "Columns": [
        { "Name": "id", "DbName": "id", "Update": true, "Key": true, "Identity": true, "UpdateWhereClause": true },
        { "Name": "name", "DbName": "name", "Update": true, "Key": false, "Identity": false, "UpdateWhereClause": true },
        { "Name": "age", "DbName": "age", "Update": true, "Key": false, "Identity": false, "UpdateWhereClause": true },
        { "Name": "address", "DbName": "address", "Update": true, "Key": false, "Identity": false, "UpdateWhereClause": true },
        { "Name": "salary", "DbName": "salary", "Update": true, "Key": false, "Identity": false, "UpdateWhereClause": true },
        { "Name": "birth", "DbName": "birth", "Update": true, "Key": false, "Identity": false, "UpdateWhereClause": true }
      ]
    }
  ]
}
