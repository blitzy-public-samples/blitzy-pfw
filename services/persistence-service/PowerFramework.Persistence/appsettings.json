{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://0.0.0.0:5101",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5151",
        "Protocols": "Http2"
      }
    }
  },
  "Authentication": {
    "Jwt": {
      "Authority": "https://security-service:5104",
      "MetadataAddress": null,
      "JwksPath": "/.well-known/jwks.json",
      "Audience": "powerframework-persistence",
      "RequireHttpsMetadata": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true
    }
  },
  "Persistence": {
    "Sqlite": {
      "DataDirectory": "/var/lib/powerframework",
      "DatabaseFileName": "test.db",
      "Mode": "rwc",
      "Check": null,
      "Journal": "DELETE",
      "Uri": ""
    },
    "TransactionPool": {
      "KeepAlive": false,
      "KeepAliveExpireSeconds": 0,
      "TransactionClassName": ""
    },
    "Query": {
      "ChunkSize": 10000,
      "MaxRows": 0,
      "PageCounting": true,
      "Cache": false,
      "PageIndex": 0,
      "PageSize": 0,
      "Paged": false
    },
    "Errors": {
      "RedactSqlStatements": true
    }
  }
}
