{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Default": {
        "Url": "https://+:5101",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Jwt": {
    "Authority": "https://security-service:5104",
    "Audience": "powerframework-persistence",
    "JwksPath": "/.well-known/jwks.json",
    "RequireHttpsMetadata": true
  },
  "Sqlite": {
    "DataDirectory": "/var/lib/powerframework",
    "DatabaseFileName": "test.db",
    "Mode": "rwc",
    "Check": null,
    "Journal": "DELETE"
  },
  "TransactionPool": {
    "KeepAlive": false,
    "KeepAliveExpireSeconds": 0,
    "TransactionClassName": ""
  },
  "Query": {
    "ChunkSize": 10000,
    "MaxRows": 0,
    "PageCounting": true,
    "Cache": false,
    "PageIndex": 0,
    "PageSize": 0,
    "Paged": false
  }
}
