  "InternalTls": {
    "TrustedCaPath": "",

    // REVOCATION CHECKING FOR THE PEER CHAIN, AND ITS DEFAULT IS A MEASUREMENT RATHER THAN A
    // PREFERENCE. "NoCheck" | "Offline" | "Online"; an unrecognised value is a structural fault
    // and the host refuses to start rather than quietly selecting the weakest posture.
    //
    // WHY "NoCheck" SHIPS AS THE DEFAULT. The internal PKI is the local certificate authority the
    // operational docs tell an operator to build with openssl, and its certificates carry NO CRL
    // distribution point and NO OCSP responder - there is nothing anywhere for a revocation check
    // to consult. Measured directly: under both "Offline" and "Online" the chain fails with
    // RevocationStatusUnknown | OfflineRevocation, so a strict default would refuse EVERY internal
    // peer on a clean bring-up and leave the compose readiness gates permanently unsatisfiable.
    //
    // THE COMPENSATING CONTROL IS SHORT LIFETIMES, and it is enforced rather than merely claimed:
    // the documented issuance recipes all use -days 30, and Security refuses a caller certificate
    // whose DECLARED window exceeds Security:MaxCallerCertificateLifetimeDays. Set this to "Online"
    // once the internal authority publishes a reachable responder; see docs/ARCHITECTURE.md 9.7 for
    // the emergency-revocation procedure that applies while this reads "NoCheck".
    "RevocationMode": "NoCheck"
  },

  // ------------------------------------------------------------------------------------------------
  // THE BOUNDS THIS SERVICE PLACES ON ITS OWN INGRESS.
  //
  // Declared here rather than left to code defaults for the same reason the handle ceilings below are:
  // a bound too low refuses correct callers and one too high delays the discovery of an abuse, and
  // neither is visible from anywhere but this file. Every value is a plain scalar and none is a
  // credential. Configuration/IngressOptions.cs argues each one; the values here are deliberately
  // CONSERVATIVE - sized so no documented workflow meets them - and an operator sizing them to a
  // measured workload is expected to move them DOWN.
  //
  // The two message ceilings apply to gRPC, which is this service's primary transport. The receive
  // ceiling restates the framework's own default so it is visible beside the others; the send ceiling
  // is the one the framework leaves unbounded.
  // ------------------------------------------------------------------------------------------------
  "Ingress": {
    "MaxRequestBodyBytes": 16777216,
    "MaxRequestHeadersTotalBytes": 32768,
    "MaxConcurrentConnections": 256,
    "MaxHttp2StreamsPerConnection": 100,
    "RequestHeadersTimeoutSeconds": 15,
    "MaxConcurrentRequests": 512,
    "RateLimitPermitsPerWindow": 4000,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0,
    "MaxReceiveMessageBytes": 4194304,
    "MaxSendMessageBytes": 33554432
  },
  "Schema": {
    "ApplyMigrationsOnStartup": false
  },
  "Handles": {
    "MaxTotalPerRegistry": 512,
    "MaxPerPrincipal": 128,
    "IdleExpirySeconds": 900,
    "SweepIntervalSeconds": 60
  },
