{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Information",
      "PowerFramework.Security": "Debug"
    }
  },

  // ------------------------------------------------------------------------------------------------
  // KESTREL - THE TLS LISTENER, RESTATED, AND NO PLAINTEXT LISTENER IN ANY ENVIRONMENT
  // ------------------------------------------------------------------------------------------------
  //
  // THE TLS LISTENER IS UNCHANGED AND IS RESTATED RATHER THAN INHERITED. Configuration sections merge
  // per key, so naming `Https` here would be enough to keep it; it is spelled out in full because a
  // reader of THIS file has to be able to see that the trust bootstrap is still TLS in development.
  // Its certificate still comes from Kestrel__Certificates__Default__Path and __KeyPath in the
  // environment - for a local bring-up, a self-signed PEM pair generated by the operator. No path,
  // no password and no thumbprint appears in this file either (C-F).
  //
  // AN ADDITIONAL PLAINTEXT READINESS LISTENER WAS CONSIDERED AND IS WITHDRAWN. The attached
  // environment's gate is `curl -sf http://localhost:<port>/health`, and binding a second cleartext
  // endpoint carrying only `GET /health` would keep that gate answerable unchanged. It is not bound,
  // and the reason is that the restriction lives nowhere in the transport: a listener that serves one
  // anonymous route today is one route registration away from serving the token endpoint, the
  // published key set or a C-02 operation, and this is the one service where that would substitute the
  // trust bootstrap for every verifier in the stack. `OpenApi/security.v1.yaml` states the same policy
  // as the published contract: this service binds exactly one endpoint, in every environment.
  //
  // THE OPERATIONAL CONSEQUENCE, STATED SO IT IS NOT DISCOVERED AT A FAILING GATE. The readiness probe
  // for THIS service is an HTTPS request - `curl -sf --cacert <ca> https://localhost:5104/health` -
  // and the Compose health check for it must be written that way. The other three services keep their
  // documented probes on their own listeners. `orchestration/.env.example` section 1 carries the
  // certificate-generation recipe and the trust-anchor path, and `docs/ARCHITECTURE.md` records the
  // deviation from the attached environment's documented gate and why the TLS mandate wins here.
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://+:5104",
        "Protocols": "Http1AndHttp2",
        "ClientCertificateMode": "AllowCertificate",
        "SslProtocols": [ "Tls12", "Tls13" ]
      }
    }
  },

  // The issuer claim follows the listener. It is the https loopback address in development for the
  // same reason the listener is TLS: a consumer's stock bearer handler derives the metadata address
  // from this value, and a plaintext issuer would send it to fetch the key set over a channel an
  // attacker can rewrite. RequireHttpsMetadata therefore stays true here as well - the development
  // relaxation this system permits is a self-signed certificate, never plaintext metadata.
  "Security": {
    "Issuer": "https://localhost:5104"
  }
}
