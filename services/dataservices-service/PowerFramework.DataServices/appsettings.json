{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "https://+:5102",
        "Protocols": "Http1AndHttp2"
      }
    }
  },

  "Authentication": {
    "Jwt": {
      "Authority": "https://security-service:5104",
      "MetadataAddress": null,
      "Audience": "powerframework-dataservices",
      "RequireHttpsMetadata": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true,
      "MetadataRefreshInterval": "00:00:05",
      "MetadataAutomaticRefreshInterval": "00:05:00",
      "PermittedCallers": [ "powerframework-gateway" ]
    }
  },

  "Ingress": {
    "MaxRequestBodyBytes": 16777216,
    "MaxRequestHeadersTotalBytes": 32768,
    "MaxConcurrentConnections": 256,
    "MaxHttp2StreamsPerConnection": 100,
    "RequestHeadersTimeoutSeconds": 15,
    "MaxConcurrentRequests": 512,
    "RateLimitPermitsPerWindow": 4000,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0,
    "MaxReceiveMessageBytes": 4194304,
    "MaxSendMessageBytes": 33554432
  },

  "DataServices": {
    "Localization": {
      "Locale": "en"
    },

    "RowSelect": {
      "Style": 1
    },

    "ContextMenu": {
      "ColAutoWidth": true,
      "ColCheck": true,
      "ColCopy": true,
      "ColPaste": true,
      "ItemCopy": true
    },

    "ColumnExpression": {
      "Trace": false,
      "RedrawSuppressionRowThreshold": 200,
      "CalcStackInitialCapacity": 20,
      "PageResolution": "WholeBuffer",
      "PageRowsPerPage": 0,
      "MacroInvocationTimeout": "00:05:00"
    },

    "DropDownSearch": {
      "FilterType": 3,
      "ShowFilteredRows": null,
      "PinyinMatchFlags": 7
    },

    "Persistence": {
      "Address": "https://persistence-service:5101"
    },

    "Security": {
      "BaseAddress": "https://security-service:5104",

      "MutualTls": {
        "CertificatePath": "",
        "CertificateKeyPath": ""
      }
    },

    "InternalTls": {
      "TrustedCaPath": "",
      "RevocationMode": "NoCheck"
    },

    "Resilience": {
      "Persistence": {
        "MaxRetryAttempts": 3,
        "RetryBaseDelay": "00:00:02",
        "CircuitBreakerFailureRatio": 0.1,
        "CircuitBreakerMinimumThroughput": 100,
        "CircuitBreakerSamplingDuration": "00:00:30",
        "CircuitBreakerBreakDuration": "00:00:05",
        "RequestTimeout": "00:00:30",
        "StreamDeadline": "00:15:00"
      },
      "Security": {
        "MaxRetryAttempts": 3,
        "RetryBaseDelay": "00:00:02",
        "CircuitBreakerFailureRatio": 0.1,
        "CircuitBreakerMinimumThroughput": 100,
        "CircuitBreakerSamplingDuration": "00:00:30",
        "CircuitBreakerBreakDuration": "00:00:05",
        "RequestTimeout": "00:00:30",
        "StreamDeadline": "00:15:00"
      }
    },

    "Sessions": {
      "ValidationSession": {
        "IdleTimeout": "00:05:00",
        "MaxConcurrentSessions": 100
      },
      "ExpressionSession": {
        "IdleTimeout": "00:05:00",
        "MaxConcurrentSessions": 100
      }
    },

    "EventChain": {
      "StrictOrdering": true,
      "AnswerTimeout": "00:05:00",
      "MaxPendingNotifications": 64
    },

    "RestProjection": {
      "MaxStreamedElements": 10000,
      "StreamCollectionWindow": "00:00:02"
    },

    "PersistenceSession": {
      "Dbms": "SQLite",
      "ServerName": "",
      "Database": "",
      "LogId": "",
      "LogPass": "",
      "DbParm": "",
      "Lock": "",
      "AutoCommit": false,
      "UserParm": ""
    }
  }
}
