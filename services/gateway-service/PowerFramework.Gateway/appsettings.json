{
  // ------------------------------------------------------------------------------------------------
  // THE PUBLISHED INGRESS LISTENER. `https://+:5105` is the composition root's documented access URL,
  // and it is declared HERE rather than left to the orchestration layer.
  // ------------------------------------------------------------------------------------------------
  //
  // WHY IT IS DECLARED AT ALL, WHICH IS A CORRECTION. An earlier revision left this section out on the
  // reasoning that the ingress address belongs to whatever fronts it, so the orchestration layer should
  // supply it. The reasoning is defensible and its consequence was not: nothing in this repository then
  // bound 5105. There is no Compose manifest yet, and the orchestration template's variable roster
  // carries no `ASPNETCORE_URLS`, so a plain `dotnet run` bound Kestrel's own default of 5000 - measured
  // directly - and the ONE address the attached environment documents as the composition root,
  // `localhost:5105`, was reachable by no means the repository provided. A documented address
  // that nothing binds is worse than an undocumented one, because a reader has no reason to doubt it.
  //
  // TLS, LIKE THE OTHER THREE, AND ON THE INGRESS THAT IS NOT OPTIONAL. This is the one listener
  // external clients reach, and every request that crosses it carries a bearer token - so a cleartext
  // listener here would expose every caller's credential to anyone on path (CWE-319). The environment
  // gates this service on `curl -sf http://localhost:5105/health`; that gate is a probe SHAPE and
  // restates as `curl -sf --cacert <anchor> https://localhost:5105/health`, which is exactly what this
  // image's HEALTHCHECK does. The certificate comes from `Kestrel__Certificates__Default__Path` and
  // `__KeyPath` in the deployment's own secret layer; none is committed here, and Kestrel REFUSES TO
  // START rather than downgrading if it cannot resolve one.
  //
  // `Http1` AND NOT `Http1AndHttp2`. Gateway is REST + OpenAPI and publishes no gRPC contract, so it
  // needs no HTTP/2 endpoint - and a listener that accepts only what it is for cannot be misaddressed
  // silently. Unlike Persistence and DataServices, Gateway therefore needs no second endpoint at all.
  //
  // An overriding environment still wins: `ASPNETCORE_URLS` and
  // `Kestrel__Endpoints__Default__Url` both take precedence over this file, so declaring it removes an
  // unbound default without taking the address away from an operator who wants to move it.
  "Kestrel": {
    "Endpoints": {
      "Default": {
        "Url": "https://+:5105",
        "Protocols": "Http1"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "RequireHttpsMetadata": true,
        "ValidAudiences": [ "powerframework-gateway" ],
        "MapInboundClaims": false,

        // 🔴 THE TWO KEY-SET REFRESH INTERVALS. Together they bound how long a signing-key rotation at
        // Security leaves this boundary's verdicts INVERTED - a token minted before the rotation still
        // accepted, one minted after it refused 401 with IDX10503. The first is the floor before a refresh
        // that a rejected token asked for is actually performed; the second is the background interval, and
        // it is the only thing that ever drops a RETIRED key, because a successful validation provokes no
        // refresh. Left unset the token library's defaults are five minutes and TWELVE HOURS respectively.
        // Both are validated at startup against the library's own minimums (1 second, 5 minutes), so a
        // value it would throw on becomes a refusal to start rather than a first-request failure. The
        // background interval additionally BOUNDS the last-known-good fallback lifetime, which the
        // library leaves at one hour: without that bound a retired key stays acceptable long after the
        // current key set has been replaced (measured at nine and a half minutes and rising).
        // docs/ARCHITECTURE.md section 9.6 tabulates both; docs/SECRETS.md section 4.2.1 is the runbook.
        "MetadataRefreshInterval": "00:00:05",
        "MetadataAutomaticRefreshInterval": "00:05:00"
      }
    }
  },
  "Gateway": {
    "Locale": "en",
    "CapabilityFlags": 3847,
    "Upstreams": {
      "DataServices": "https://localhost:5102",
      "Security": "https://localhost:5104"
    },
    "HealthProbes": {
      "Persistence": "https://localhost:5101",
      "DataServices": "https://localhost:5102",
      "Security": "https://localhost:5104"
    },
    "MutualTls": {
      "CertificatePath": "",
      "CertificateKeyPath": ""
    },
    "InternalTls": {
      "TrustedCaPath": ""
    },
    "Outbound": {
      "RequestTimeout": "00:00:30",
      "StreamDeadline": "00:05:00"
    },
    "RestProjection": {
      // A RESOURCE BOUND, NOT A PERFORMANCE SETTING - no performance objective is asserted anywhere in
      // this refactor. This gateway is the process every request in the system passes through, so an
      // unbounded upstream stream would be an unbounded amount of work at the one place that cannot
      // afford it.
      //
      // Exceeding it abandons the JSON document WITHOUT its closing bracket, deliberately: a truncated
      // array that closed cleanly could not be told apart from a complete one, so the caller must be able
      // to detect that it did not receive everything.
      //
      // Generous rather than tight - a legitimate chunked retrieval produces one element per CHUNK rather
      // than per row, so a realistic result is nowhere near this.
      "MaxStreamedElements": 10000,

      // THE Retry-After HINT SENT WITH EVERY 429, and only with a 429. RFC 9110 10.2.3 defines the header
      // for exactly a response that invites a later retry, and every stock HTTP client and service mesh
      // reads it - so a 429 without one leaves a caller either retrying immediately, adding load to a
      // service that has just said it has none to spare, or waiting a duration it invented.
      //
      // A CONFIGURED HINT, NOT A DERIVED PROMISE. This gateway cannot know when an upstream concurrency
      // ceiling will clear: the sessions behind it are released by other callers' closes and by an idle
      // sweep whose timeout is that service's setting rather than this one's. No service-level agreement,
      // latency budget or availability commitment is published anywhere in this system, so nothing here
      // asserts one. Five seconds is short enough for a caller's retry to be useful and long enough to
      // discourage a tight loop.
      //
      // WITHHELD FROM 503 DELIBERATELY: that status means an upstream is unreachable rather than at a
      // ceiling, and nothing here knows when an unreachable service returns.
      "RetryAfter": "00:00:05"
    }
  }
}
