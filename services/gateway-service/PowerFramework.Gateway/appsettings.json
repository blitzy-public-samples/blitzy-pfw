{
  "Kestrel": {
    "Endpoints": {
      "Default": {
        "Url": "https://+:5105",
        "Protocols": "Http1"
      }
    }
  },

  "Ingress": {
    "MaxRequestBodyBytes": 8388608,
    "MaxRequestHeadersTotalBytes": 32768,
    "MaxConcurrentConnections": 512,
    "MaxHttp2StreamsPerConnection": 100,
    "RequestHeadersTimeoutSeconds": 15,
    "MaxConcurrentRequests": 256,
    "RateLimitPermitsPerWindow": 2000,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "RequireHttpsMetadata": true,
        "ValidAudiences": [ "powerframework-gateway" ],
        "MapInboundClaims": false,
        "MetadataRefreshInterval": "00:00:05",
        "MetadataAutomaticRefreshInterval": "00:05:00"
      }
    }
  },
  "Gateway": {
    "Locale": "en",
    "CapabilityFlags": 3847,
    "Upstreams": {
      "DataServices": "https://localhost:5102",
      "Security": "https://localhost:5104"
    },
    "HealthProbes": {
      "Persistence": "https://localhost:5101",
      "DataServices": "https://localhost:5102",
      "Security": "https://localhost:5104"
    },
    "MutualTls": {
      "CertificatePath": "",
      "CertificateKeyPath": ""
    },
    "InternalTls": {
      "TrustedCaPath": "",
      "RevocationMode": "NoCheck"
    },
    "Outbound": {
      "RequestTimeout": "00:00:30",
      "StreamDeadline": "00:05:00"
    },
    "RestProjection": {
      "MaxStreamedElements": 10000,
      "RetryAfter": "00:00:05"
    }
  }
}
