<Project>

  <!--
    Central Package Management for the PowerFramework .NET 10 decomposition.

    Every project references these packages WITHOUT a Version attribute; the single source of
    truth for versions is this file. Enabled by ManagePackageVersionsCentrally in
    Directory.Build.props.

    Every version below was resolved against nuget.org and verified by an actual restore + build
    on this machine with SDK 10.0.302 under TreatWarningsAsErrors. No floating versions, no
    wildcards, no "latest".

    ================================ MANDATORY PINS ================================
    1) Microsoft.OpenApi = 2.11.0
       Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0 transitively, which
       raises NuGet audit warning NU1903 (high severity). Moving to the 3.x line instead BREAKS
       the build: the 10.0.x OpenAPI source generator is compiled against the 2.x object model and
       emits two CS0200 errors ("cannot assign - read only") from the generated XML-comment
       support file. 2.11.0 is the highest published 2.x and the only value that is simultaneously
       non-vulnerable and compatible. Every REST service must respect this.

    2) SQLitePCLRaw.bundle_e_sqlite3 = 3.0.5
       Microsoft.EntityFrameworkCore.Sqlite 10.0.10 transitively pulls a 2.1.x native bundle that
       raises NU1903. An explicit direct reference to 3.0.5 overrides it and clears the audit.
    ================================================================================
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="gRPC and Protobuf (Contracts, DataServices, Persistence + client sides)">
    <!-- Pulls Grpc.Tools 2.83.0 and Google.Protobuf 3.31.1 transitively; neither needs an
         explicit reference. Google.Protobuf resolves to 3.31.1 (not the newer line) because
         Grpc.AspNetCore 2.83.0 constrains it. -->
    <!-- Grpc.AspNetCore also carries Grpc.AspNetCore.Server.ClientFactory, so the Gateway and
         DataServices client sides need no additional package reference. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup Label="OpenAPI / REST surfaces (Gateway, Security, DataServices REST projection)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- MANDATORY PIN - see header. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup Label="Authentication - JWT bearer validation on every internal edge">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Token MINTING. Security only: Security is the sole issuer in the system. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence - SQLite is the only evidenced storage engine">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- ADO-level access for the legacy test.db?mode=rwc[,password] URI grammar and for raw
         command execution with positional binding, neither of which EF Core alone expresses. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- MANDATORY PIN - see header. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup Label="Resilience on the newly created network edges (Gateway, DataServices)">
    <!-- Required BY the decomposition: an in-process call cannot fail in transit, a network call
         can. Pulls Microsoft.Extensions.Resilience 10.8.0 and the Polly family at 8.4.2. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup Label="Test stack - all *.Tests projects">
    <!-- xunit.v3 requires <OutputType>Exe</OutputType>. Test projects are HAND-AUTHORED:
         `dotnet new xunit3` does not exist in this SDK and `dotnet new xunit` scaffolds v2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Emits coverage.cobertura.xml, the artifact the 80%-line-coverage-per-service gate is
         measured from, via: dotnet test (collect XPlat Code Coverage) -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- In-process host for service-level tests alongside unit tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

</Project>
